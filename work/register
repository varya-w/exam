<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
     <div class="navbar">
        <a href="index.html" class="navbar-brand">
            <img src="1.jpg" class="logo"alt="Грузовозофф">
            <span>Грузовозофф</span>
        </a>
        <ul class="navbar-nav">
            <li><a href="index.html">Авторизация</a></li>
        </ul>
    </div>
    <div class="container">
        <h1>Регистрация</h1>
        <form id="registerForm">
            <div class="form-group">
                <label for="regLogin">Логин (кириллица, ≥6 символов):</label>
                <input type="text" id="regLogin" name="login" pattern="[А-Яа-яЁё]{6,}" required>
            </div>
            <div class="form-group">
                <label for="regPassword">Пароль (≥6 символов):</label>
                <input type="password" id="regPassword" name="password" minlength="6" required>
            </div>
            <div class="form-group">
                <label for="fullName">ФИО:</label>
                <input type="text" id="fullName" name="fullName" pattern="[А-Яа-яЁё\s]+" required>
            </div>
            <div class="form-group">
                <label for="phone">Телефон:</label>
                <input type="tel" id="phone" name="phone" pattern="\+7\(\d{3}\)-\d{3}-\d{2}-\d{2}" placeholder="+7(XXX)-XXX-XX-XX" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
           <div class="btn-container">
                <button type="submit" class="btn">Зарегистрироваться</button>
            </div>
        </form>
        <p>Уже есть аккаунт? <a href="index.html">Войти</a></p>
    </div>
</body>
</html>
