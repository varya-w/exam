<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>новая заявка</title>
     <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <div class="logo-container"> 
            <div class="logo">  <img src="1.png" alt="Logo" height="60">  </div>
            <div class="logo-text">Сервис для заказа товаров «Авоська»</div>
        </div>
        <nav>
            <ul>
                 <li><a href="requests.html">Мои заказы</a></li>
                  <li><a href="registration.html">Выйти</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <div class="new-request-box">
                <h2>Формирование заказа</h2>
        <form id="create-order-form">
            <div class="form-group">
                <label for="product">Товар:</label>
                <select id="product" name="product" required>
                    <option value="">Выберите товар</option>
                    <option value="Яблоки">Яблоки</option>
                    <option value="Апельсины">Апельсины</option>
                    <option value="Бананы">Бананы</option>
                    <!-- Другие товары -->
                </select>
            </div>
            <div class="form-group">
                <label for="quantity">Количество:</label>
                <input type="number" id="quantity" name="quantity" required min="1">
            </div>
            <div class="form-group">
                <label for="address">Адрес доставки:</label>
                <input type="text" id="address" name="address" required>
            </div>
            <button type="submit">Оформить заказ</button>
            </form>
        </div>
    </main>
</body>
</html>
